        <Option type="List" name="FIELD_LENGTH">
          <Option type="Map">
            <Option value="2" type="int" name="source"/>
            <Option value="12" type="int" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="FIELD_NAME">
          <Option type="Map">
            <Option value="2" type="int" name="source"/>
            <Option value="position" type="QString" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="FIELD_TYPE">
          <Option type="Map">
            <Option value="2" type="int" name="source"/>
            <Option value="2" type="int" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="FORMULA">
          <Option type="Map">
            <Option value="'CASE WHEN &quot;distance&quot; &lt;= 0 THEN ''zip'' WHEN &quot;distance&quot; &lt;= ' || to_string(@immediate) || ' THEN ''immediate'' WHEN &quot;distance&quot; &lt;= ' || to_string(@rapprochee) || ' THEN ''rapprochee'' WHEN &quot;distance&quot; &lt;= ' || to_string(@eloignee) || ' THEN ''eloignee'' ELSE ''hors'' END'" type="QString" name="expression"/>
            <Option value="3" type="int" name="source"/>
          </Option>
        </Option>
        <Option type="List" name="INPUT">
          <Option type="Map">
            <Option value="proche" type="QString" name="child_id"/>
            <Option value="OUTPUT" type="QString" name="output_name"/>
            <Option value="1" type="int" name="source"/>
          </Option>
        </Option>
      </Option>
    </Option>
