            <Option value="2" name="source" type="int"/>
            <Option value="2" name="static_value" type="int"/>
          </Option>
        </Option>
        <Option name="FORMULA" type="List">
          <Option type="Map">
            <Option value="'CASE WHEN &quot;distance&quot; &lt;= 0 THEN ''zip'' WHEN &quot;distance&quot; &lt;= ' || to_string(@immediate) || ' THEN ''immediate'' WHEN &quot;distance&quot; &lt;= ' || to_string(@rapprochee) || ' THEN ''rapprochee'' WHEN &quot;distance&quot; &lt;= ' || to_string(@eloignee) || ' THEN ''eloignee'' ELSE ''hors'' END'" name="expression" type="QString"/>
            <Option value="3" name="source" type="int"/>
          </Option>
        </Option>
        <Option name="INPUT" type="List">
          <Option type="Map">
            <Option value="proche" name="child_id" type="QString"/>
            <Option value="OUTPUT" name="output_name" type="QString"/>
            <Option value="1" name="source" type="int"/>
          </Option>
        </Option>
      </Option>
